# Frontend — safe to ship in the bundle, guarded by RLS.
VITE_SUPABASE_URL=https://satvpduraxbmxapbjhrw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Worker and integration/e2e tests only. NEVER prefix these with VITE_ —
# anything VITE_ is inlined into the client bundle, and the secret key
# bypasses every RLS policy.
SUPABASE_URL=https://satvpduraxbmxapbjhrw.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
DEEPGRAM_API_KEY=

# Fixed credentials for the Playwright test user.
E2E_TEST_EMAIL=e2e@test.local
E2E_TEST_PASSWORD=

# Dev only. "true" renders protected routes without signing in — useful for
# working on /upload, which parses the book entirely in the browser. It does
# NOT give you data: requests still go out unauthenticated and RLS returns
# nothing. Ignored by production builds (the branch is compiled out) and
# forced off during Playwright runs.
VITE_AUTH_BYPASS=false
