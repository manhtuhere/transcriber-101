# Frontend — safe to ship in the bundle, guarded by RLS.
VITE_SUPABASE_URL=https://satvpduraxbmxapbjhrw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Worker and integration/e2e tests only. NEVER prefix these with VITE_ —
# anything VITE_ is inlined into the client bundle, and the secret key
# bypasses every RLS policy.
SUPABASE_URL=https://satvpduraxbmxapbjhrw.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
DEEPGRAM_API_KEY=

# Fixed credentials for the Playwright test user.
E2E_TEST_EMAIL=e2e@test.local
E2E_TEST_PASSWORD=

# Dev only. The account behind the "Sign in as developer" button on the
# sign-in page, which skips the magic-link round trip. It is a real session,
# so RLS applies exactly as in production. Create the user in Supabase under
# Authentication → Users with "Auto Confirm User" on. Compiled out of
# production builds, credentials and all.
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
